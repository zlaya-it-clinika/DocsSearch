# Подробные логи веб-сервера: true или false
DEBUG=false

# Где слушает веб-сервер
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Адрес Go-ядра. Браузер в ядро не ходит, запросы идут через /api этого сервера
CORE_API_URL=http://localhost:8080
# Адрес ядра для docker compose этого каталога. По умолчанию ядро на хосте: http://host.docker.internal:8080
CORE_API_URL_DOCKER=
# Сколько ждать ответ ядра, мс. Локальная модель может думать долго
CORE_TIMEOUT_MS=120000

# Уровни доступа ядра: с какого уровня пользователь считается администратором
ADMIN_ACCESS_LEVEL=2
USER_ACCESS_LEVEL=1

# Сессия браузера: время жизни без активности, минуты
SESSION_TTL_MINUTES=480
# Cookie: Secure нужен при HTTPS. Для виджета на портале с другого домена: SameSite=None и Secure=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Порталы, которым можно встраивать виджет, через пробел. Пример: https://portal.corp.local
EMBED_ALLOWED_ORIGINS=

# Ограничение размера загружаемого файла, мегабайты
MAX_UPLOAD_MB=20

# Защита входа от перебора: попыток за окно в минутах
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
