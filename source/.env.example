# Настройки общего docker compose в этом каталоге. Скопируйте в .env и поправьте

# Пароль страницы /docs ядра. Обязателен
DOCS_PASSWORD=

# Подробные логи ядра и веба: true или false
DEBUG=false

# Режим ядра: live - PostgreSQL и Ollama, stub - фиксированные ответы без базы и модели
API_MODE=live

# Порт веба на этой машине. Его открывают сотрудники: http://localhost:3000
WEB_PORT=3000
# Порт ядра на 127.0.0.1 для отладки страницы /docs
API_PORT_LOCAL=8080

# PostgreSQL внутри compose. Данные лежат в томе docssearch_postgres-data
POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docssearch

# Ollama на этой машине: http://host.docker.internal:11434
# Ollama в контейнере (профиль ollama): http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# Чат-модель: Vikhr-Nemo-12B, собирается из source/ollama/vikhr-nemo.Modelfile (см. LOCAL_AI.md)
OLLAMA_CHAT_MODEL=vikhr-nemo
# Modelfile чат-модели для профиля ollama. Пусто - модель OLLAMA_CHAT_MODEL просто скачивается из библиотеки Ollama
OLLAMA_CHAT_MODELFILE=vikhr-nemo.Modelfile
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768

# Ядро: заглушка без admin/admin и user/user, если false. Нужно только при API_MODE=stub
STUB_SEED_USERS=true

# Вход и регистрация, как в open-webui. Это начальные значения: после сохранения в админ-панели
# («Настройки») действуют значения из базы. Первая учётная запись всегда становится администратором
ENABLE_SIGNUP=true
# Роль новых пользователей: pending (ждут подтверждения), user или admin
DEFAULT_USER_ROLE=pending
SHOW_ADMIN_DETAILS=true

# Вход через LDAP или Active Directory
ENABLE_LDAP=false
LDAP_SERVER_LABEL=LDAP
LDAP_SERVER_HOST=
# Пусто - 389, с LDAP_USE_TLS=true - 636
LDAP_SERVER_PORT=
# Служебная учётная запись только для чтения. Пусто - анонимный поиск
LDAP_APP_DN=
LDAP_APP_PASSWORD=
# Active Directory - sAMAccountName, OpenLDAP - uid
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
LDAP_SEARCH_BASE=
# Например: (&(memberOf=CN=DocsSearch,OU=Groups,DC=corp,DC=local)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_SEARCH_FILTERS=
# LDAPS. Файл CA в формате PEM внутри контейнера api (см. volumes в docker-compose.yml),
# проверка сертификата, шифры: ALL или имена через двоеточие
LDAP_USE_TLS=false
LDAP_CA_CERT_FILE=
LDAP_VALIDATE_CERT=true
LDAP_CIPHERS=ALL

# Веб: ожидание ответа ядра, мс. Локальная модель может думать долго
CORE_TIMEOUT_MS=120000

# Веб: роли и сессии
ADMIN_ACCESS_LEVEL=2
USER_ACCESS_LEVEL=1
SESSION_TTL_MINUTES=480

# Веб: cookie. Для виджета на портале с другого домена нужны HTTPS, COOKIE_SECURE=true и COOKIE_SAMESITE=None
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
EMBED_ALLOWED_ORIGINS=

# Веб: загрузка файлов и защита входа
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.txt .pdf .docx
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
