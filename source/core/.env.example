DEBUG=false
API_MODE=stub
API_PORT=8080
DOCS_PASSWORD=
DATABASE_URL=postgres://docs:docs@localhost:5432/docssearch?sslmode=disable
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768

# Заглушка: false - старт без admin/admin и user/user, первый вход через регистрацию администратора
STUB_SEED_USERS=true

# Вход и регистрация, как в open-webui. Это начальные значения: после сохранения в админ-панели
# («Настройки») действуют значения из базы. Первая учётная запись всегда становится администратором
ENABLE_SIGNUP=true
# Роль новых пользователей: pending (ждут подтверждения), user или admin
DEFAULT_USER_ROLE=pending
SHOW_ADMIN_DETAILS=true

# Вход через LDAP или Active Directory
ENABLE_LDAP=false
LDAP_SERVER_LABEL=LDAP
LDAP_SERVER_HOST=
# Пусто - 389, с LDAP_USE_TLS=true - 636
LDAP_SERVER_PORT=
# Служебная учётная запись только для чтения. Пусто - анонимный поиск
LDAP_APP_DN=
LDAP_APP_PASSWORD=
# Active Directory - sAMAccountName, OpenLDAP - uid
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
LDAP_SEARCH_BASE=
# Например: (&(memberOf=CN=DocsSearch,OU=Groups,DC=corp,DC=local)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_SEARCH_FILTERS=
# LDAPS. Файл CA в формате PEM, проверка сертификата, шифры: ALL или имена через двоеточие
LDAP_USE_TLS=false
LDAP_CA_CERT_FILE=
LDAP_VALIDATE_CERT=true
LDAP_CIPHERS=ALL
# При входе заменить роли пользователя ролями, чей ldapGroup совпал с CN из каталога
ENABLE_LDAP_GROUP_MANAGEMENT=false
LDAP_ATTRIBUTE_FOR_GROUPS=memberOf

# Вход Windows: билет Negotiate сверяется с keytab. Имя службы: HTTP/host@REALM
ENABLE_KERBEROS=false
KERBEROS_KEYTAB=
KERBEROS_SERVICE_PRINCIPAL=
